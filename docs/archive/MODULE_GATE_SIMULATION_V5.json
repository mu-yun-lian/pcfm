{
  "schema_version": "cognitive-module-gate-v1",
  "module": {
    "id": "conversation_conditioned_response_simulation",
    "version": "5",
    "status": "implemented_exploratory"
  },
  "claim": {
    "operational_target": "Select an auditable next-response content plan from reviewed public episodes, full conversation state, and a validated semantic query candidate.",
    "interpretation": "Observable public-response projection only.",
    "non_claims": [
      "private belief or motive identification",
      "calibrated real-person prediction accuracy",
      "language-model semantic candidates as factual truth"
    ],
    "alternatives": [
      "generic model prior",
      "nearest-event copying",
      "topic overlap rather than person specificity",
      "mechanically cut source span mistaken for an episode"
    ],
    "refusal_state": "clarification_needed or no_person_projection",
    "scope": "One versioned person, public response episodes, ordinary multi-turn text conversation, declared time and relationship scope."
  },
  "identifiability": {
    "distinguishing_evidence": "Time- and lineage-separated whole-conversation holdouts against current-message-only, wrong-person, shuffled-history, retrieval-only, and generic-model baselines.",
    "unidentified_questions": [
      "private sincerity",
      "complete real-person knowledge",
      "accuracy outside observed public contexts"
    ]
  },
  "evidence": {
    "roles": [
      "candidate_discovery",
      "parameter_fitting",
      "applicability_calibration",
      "sealed_temporal_holdout",
      "reality_comparison",
      "post_deployment_monitoring"
    ],
    "role_separation": true,
    "future_holdout": false,
    "lineage_bound": true,
    "content_replay_checked": true,
    "completeness_boundary": "Hashes verify supplied bytes and lineage, not source completeness or truth of metadata."
  },
  "computation": {
    "deployment_kernel": "SimulationKernelV5.predict",
    "selection_kernel": "SimulationKernelV5.predict",
    "same_predictive_kernel": true,
    "uncertainty_scope": "Evidence, semantic mapping, context resolution, temporal transfer, local support, and model-form uncertainty; not a calibrated accuracy interval.",
    "order_invariant": true
  },
  "gates": {
    "hard_floors": true,
    "base_eligibility": true,
    "global_and_local_applicability": true,
    "metadata_scope": true,
    "temporal_direction_and_expiry": true
  },
  "artifacts": {
    "versioned_schema": true,
    "integrity_bound": true,
    "raw_evidence_recomputable": true,
    "old_version_refused": true
  },
  "integration": {
    "unified_entry_point": true,
    "downstream_consumers": [
      "ConversationWorkbench.send_message",
      "reality comparison",
      "optimization holdout evaluation",
      "person export and summary"
